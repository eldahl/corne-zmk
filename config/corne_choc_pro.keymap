#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include "keys_da.h"

/ {
    chosen { zmk,physical-layout = &default_layout; };
};

/ {
    keymap {
        compatible = "zmk,keymap";

        qwerty {
            display-name = "QWERTY";

            // --------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |  MUTE |  PP   |  Y  |  U   |  I  |  O  |  P  | BSPC |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |  LALT |  RALT |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |               |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |               | ENT | RSE  | ALT |

            bindings = <
&kp ESCAPE        &kp Q  &kp W  &kp E  &kp R      &kp T  &kp LEFT_GUI  &kp RIGHT_GUI  &kp Y  &kp U  &kp I         &kp O  &kp P            &kp DA_A_RING
&kp LEFT_SHIFT    &kp A  &kp S  &kp D  &kp F      &kp G  &kp LEFT_ALT  &kp RIGHT_ALT  &kp H  &kp J  &kp K         &kp L  &kp DA_AE        &kp DA_O_SLASH
&kp LEFT_CONTROL  &kp Z  &kp X  &kp C  &kp V      &kp B                               &kp N  &kp M  &kp DA_ACUTE  &none  &kp PRINTSCREEN  &kp LG(RS(PRINTSCREEN))
                                &mo 2  &kp SPACE  &mo 1                               &mo 3  &mo 4  &mo 5
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_DN C_VOL_UP>,
                <&inc_dec_kp PG_UP PG_DN>,
                <&inc_dec_kp C_PREV C_NEXT>,
                <&inc_dec_kp C_BRI_DN C_BRI_UP>;
        };

        layer1 {
            display-name = "SYMBOL";

            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  | LCTRL | RCTRL |  ^  |  &  |  *  |  (  |  )  | BSPC |
            // | CTRL | HUD | HUI |     |     |     |  LALT | RALT  |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |               |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |               | ENT |     | ALT |

            bindings = <
&kp TAB    &kp DA_EXCLAMATION  &kp DA_PIPE       &kp DA_LEFT_BRACE        &kp RIGHT_BRACE           &kp DA_QUESTION      &none  &none  &kp DA_AMPERSAND  &kp DA_SLASH  &kp DA_BACKSLASH  &kp DA_DOUBLE_QUOTES  &kp DA_SINGLE_QUOTE  &kp DA_ACUTE
&kp LCTRL  &kp DA_AT           &kp DA_CARET      &kp DA_LEFT_PARENTHESIS  &kp DA_RIGHT_PARENTHESIS  &kp DA_EQUAL         &none  &none  &kp DA_PERCENT    &kp DA_HASH   &kp DA_ASTERISK   &kp DA_DOLLAR         &kp DA_EURO          &none
&kp LSHFT  &trans              &kp DA_LESS_THAN  &kp DA_LEFT_BRACKET      &kp DA_RIGHT_BRACKET      &kp DA_GREATER_THAN                &kp DA_PLUS       &kp DA_MINUS  &kp DA_TILDE      &none                 &none                &none
                                                 &none                    &none                     &none                              &none             &none         &none
            >;
        };

        layer2 {
            display-name = "NUMBER";

            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5    |  LCTRL | RCTRL |  6  |  7  |  8  |  9  |  0  | BSPC |
            // | CTRL | BT1 | BT2 | BT3 | BT4 | BT5   |  LALT  | RALT  | LFT | DWN |  UP | RGT |     |      |
            // | SHFT | BTCR| RGB | RST | BOOT| Unlock|        |       |     |     |     |     |     |      |
            //                    | GUI |     | SPC   |        | ENT   |     | ALT |

            bindings = <
&none  &none  &kp K_BACK      &mmv MOVE_UP    &kp K_FORWARD    &none           &trans  &trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &bt BT_CLR
&none  &none  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &msc SCRL_UP    &trans  &trans  &none         &mkp MB1      &mkp MB2      &none         &trans        &trans
&none  &none  &none           &msc SCRL_LEFT  &msc SCRL_RIGHT  &msc SCRL_DOWN                  &trans        &trans        &trans        &trans        &trans        &trans
                              &none           &none            &none                           &none         &none         &none
            >;
        };

        layer3 {
            display-name = "EXTRA 3";
            bindings = <
&trans  &kp F1     &kp F2     &kp F3     &kp F4     &kp F5     &trans  &kp C_VOLUME_UP    &kp F6      &kp F7     &kp F8     &kp F9     &kp F10    &kp F11
&trans  &kp DA_N1  &kp DA_N2  &kp DA_N3  &kp DA_N4  &kp DA_N5  &trans  &kp C_VOLUME_DOWN  &kp DA_N6   &kp DA_N7  &kp DA_N8  &kp DA_N9  &kp DA_N0  &kp F12
&trans  &trans     &trans     &trans     &trans     &trans                                &kp K_MUTE  &trans     &trans     &trans     &trans     &trans
                              &trans     &trans     &mo 2                                 &trans      &trans     &trans
            >;
        };

        layer4 {
            display-name = "EXTRA 1";
            bindings = <
&trans  &trans  &kp DA_DOUBLE_QUOTES  &kp UP    &trans     &trans  &trans  &trans  &kp DA_COLON      &kp DA_SLASH   &kp DA_BACKSLASH  &kp DA_SINGLE_QUOTE  &trans         &trans
&trans  &trans  &kp LEFT              &kp DOWN  &kp RIGHT  &trans  &trans  &trans  &kp DA_SEMICOLON  &kp ENTER      &kp TAB           &kp DELETE           &kp BACKSPACE  &trans
&trans  &trans  &trans                &trans    &trans     &trans                  &kp DA_COMMA      &kp DA_PERIOD  &trans            &trans               &trans         &trans
                                      &trans    &trans     &trans                  &trans            &trans         &trans
            >;
        };

        layer5 {
            display-name = "EXTRA 2";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans                  &trans  &trans  &trans
            >;
        };

        extra_layer_4 {
            display-name = "EXTRA 4";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans                  &trans  &trans  &trans
            >;
        };

        extra_layer_5 {
            display-name = "EXTRA 5";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans                  &trans  &trans  &trans
            >;
        };

        extra_layer_6 {
            display-name = "EXTRA 6";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans                  &trans  &trans  &trans
            >;
        };
    };
};
